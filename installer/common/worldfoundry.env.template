# WorldFoundry - configuration
#
# Changes only take effect after the service is restarted.
# Windows: restart the service "WorldFoundry" in the Services manager (services.msc).
# Linux:   sudo systemctl restart worldfoundry
#
# This file contains the access token. It must not be readable by all users.

# Address and port of the web interface. 0.0.0.0 = reachable from the whole network,
# 127.0.0.1 = only on this computer.
HOST=@HOST@
PORT=@PORT@

# Access token for signing in (at least 8 characters). Without a token, anyone on the network would have full access.
AUTH_TOKEN=@AUTH_TOKEN@

# Storage locations. The database, Java runtimes and backups are in DATA_DIR, the Minecraft servers in SERVERS_DIR.
DATA_DIR=@DATA_DIR@
SERVERS_DIR=@SERVERS_DIR@

# Install missing Java versions automatically (Eclipse Temurin, only into DATA_DIR/runtimes)
JAVA_AUTO_INSTALL=true

# Time in seconds that Minecraft servers get to save when stopping before they are killed.
# The service waits about 180 seconds at most; if you set more, also raise the service timeout (see docs/INSTALL.md, section 8, and docs/CONFIGURATION.md).
STOP_TIMEOUT_SECONDS=120

# Backups per mod that are kept after updates (1 to 100)
MOD_BACKUP_KEEP=3

# Log level: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# Additional host names under which the interface should be reachable (comma-separated, without port).
# The computer name and IP addresses always work.
# ALLOWED_HOSTS=craft.example.lan
