{
  "name": "@worldfoundry/backend",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./contract": {
      "types": "./src/contract.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
