    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "semver": "^7.8.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
