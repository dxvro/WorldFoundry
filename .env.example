# All values are optional; the defaults are listed here.
# Address and port of the web interface. They can be changed in the web interface under System > Network & access
# (stored in the database, takes precedence); these values are the fallback. 0.0.0.0 = all network adapters,
# 127.0.0.1 = this computer only.
HOST=0.0.0.0
PORT=3000
# Location of this configuration file: only possible as a real environment variable CONFIG_FILE (default: .env in the project root).
# Relative paths in the file are then relative to it.
# DATA_DIR: database, Java runtimes (runtimes/) and backups (backups/). Default: <project>/data,
# outside a project folder a user folder (on Windows %LOCALAPPDATA%\WorldFoundry\data)
# DATA_DIR=D:\WorldFoundry\data
# SERVERS_DIR=D:\WorldFoundry\servers
LOG_LEVEL=info
# Optional: own user agent for Modrinth and loader requests (do not enter personal data)
# MODRINTH_USER_AGENT=WorldFoundry/0.1.0
# Optional: folder with the built web interface. Default: <backend>/../frontend/dist, independent of the working directory
# FRONTEND_DIR=packages/frontend/dist
# Development only (npm run dev): port and address of the Vite server, port of the backend for the proxy
# FRONTEND_PORT=5173
# FRONTEND_HOST=localhost
# BACKEND_PORT=3000
# Optional: access token (at least 8 characters). Without a value (and without a password set in the web interface) there is
# NO sign-in and anyone on the network has full access to the API. The token is the first password of the web interface;
# you can set your own password there under System. As Authorization: Bearer <token> it remains the access
# for scripts and the update service. Forgot the password: 'worldfoundry reset-password' (Linux) or the Start menu (Windows).
# AUTH_TOKEN=
# Optional: further allowed origins (comma-separated); the Vite dev proxy needs no entry
# ALLOWED_ORIGINS=
# Optional: further allowed host names (comma-separated, without port). Always allowed are IP addresses, localhost,
# *.localhost and the computer name (also with .local, .lan, .home, .home.arpa, .fritz.box). Everything else: 403 HOST_FORBIDDEN
# Further names can also be entered in the web interface (System > Network & access).
# ALLOWED_HOSTS=craft.example.lan
# Optional: wait time in seconds after "stop" before a Minecraft server is killed
STOP_TIMEOUT_SECONDS=120
# Install a missing Java version automatically (Eclipse Temurin from adoptium.net, only in the data folder, true/false)
JAVA_AUTO_INSTALL=true
# How many backups per mod are kept in mods_backup/ or plugins_backup/ after updates (1 to 100)
MOD_BACKUP_KEEP=3
# Largest allowed archive file for the world import in MB (16 to 1048576). Default 262144 = 256 GB; the free disk space is the real limit.
# IMPORT_MAX_MB=262144
# Self-update: look for new GitHub releases (true/false). Updates found are only displayed and are installed only after
# confirmation in the web interface.
# UPDATE_CHECK=true
# Source of the releases (owner/repository) and channel (stable or prerelease)
# UPDATE_REPO=dxvro/WorldFoundry
# UPDATE_CHANNEL=stable
# Countdown in seconds with which players are warned before the servers are stopped (0 to 600)
# UPDATE_COUNTDOWN_SECONDS=60
